{
  "name": "mietshaus",
  "version": "0.10.0",
  "description": "Persönliche Hausverwaltung (Miete & WEG)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "dist:mac": "bash scripts/dist-mac.sh",
    "dist:linux": "bash scripts/dist.sh linux x64",
    "test": "tsc --noEmit && ELECTRON_RUN_AS_NODE=1 electron scripts/rechentest.cjs && ELECTRON_RUN_AS_NODE=1 electron scripts/sicherungstest.cjs && ELECTRON_RUN_AS_NODE=1 electron scripts/claudetest.cjs && ELECTRON_RUN_AS_NODE=1 electron scripts/servertest.cjs",
    "test:klick": "vite build && electron scripts/klicktest.cjs .klicktest"
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.0",
    "lucide-react": "1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "productName": "Mietshaus",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "^1.0.11",
    "heic-convert": "^2.1.0",
    "imapflow": "2.1.2",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "tesseract.js": false
  }
}
